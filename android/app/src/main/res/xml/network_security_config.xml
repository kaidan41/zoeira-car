<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuração de segurança de rede.
  Permite HTTPS para todos os domínios (padrão seguro para produção).
  A API FIPE (parallelum.com.br) e YouTube usam HTTPS nativamente.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
